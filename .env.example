# ── Frontend (Vite) ───────────────────────────────────────────
# Leave empty in production — frontend and backend are on the same Vercel domain
# Set to http://localhost:4000 for local development only
VITE_API_URL=

# ── Razorpay (public key — safe to expose in frontend) ───────
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ── Backend env vars — set these in Vercel dashboard ─────────
# (these are NOT prefixed with VITE_ so they are server-side only)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=your-long-random-secret-here
ADMIN_EMAIL=your@email.com

GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxx

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx

# Both point to your Vercel URL in production
FRONTEND_URL=https://eco-herb-xi.vercel.app
BACKEND_URL=https://eco-herb-xi.vercel.app
